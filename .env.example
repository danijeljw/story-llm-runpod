# RunPod
RUNPOD_API_KEY=
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_GPU_ID=NVIDIA RTX A6000
RUNPOD_CLOUD_TYPE=COMMUNITY
RUNPOD_POD_NAME=story-writer
RUNPOD_CONTAINER_DISK_GB=20
RUNPOD_TERMINATE_AFTER=6h

# Optional placement constraints
RUNPOD_COUNTRY_CODE=
RUNPOD_DATA_CENTER_IDS=

# Pod image. This image is used as the host/container environment.
RUNPOD_IMAGE=runpod/base:0.7.0-cuda12.8.1

# llama.cpp
LLAMA_PORT=8080
LLAMA_CONTEXT=32768
LLAMA_MODEL=/workspace/models/current.gguf
LLAMA_GPU_LAYERS=999

# Local StoryRunner
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=local-gguf
